# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Required for live LLM calls (query parsing, overlay extraction, narrative generation) ---
# Get a key at https://platform.openai.com/api-keys — new accounts get free trial credits.
OPENAI_API_KEY=

# Optional: use Claude instead of/alongside OpenAI for the stronger-model
# overlay-extraction step. Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# --- Model tier selection (see README "Model tiers") ---
FAST_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o

# --- Optional: live news/policy search for the overlay extractor ---
# Without this set, search_tool.py automatically falls back to the bundled
# sample data in src/data/sample_overlay_texts.json — the demo still runs.
# Get a free-tier key at https://tavily.com/
TAVILY_API_KEY=

# --- Optional: observability and evals ---
# phoenix | langsmith | none
OBSERVABILITY_BACKEND=phoenix
PHOENIX_PROJECT=uhg-risk-intelligence
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# LangSmith (alternative to Phoenix)
# OBSERVABILITY_BACKEND=langsmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=uhg-risk-intelligence

# Hash: Off(tests/offline)
# OBSERVABILITY_BACKEND=none